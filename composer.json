{
    "name": "hiblaphp/query-builder",
    "description": "Framework Agnostic Asynchonous Query Builder",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Hibla\\QueryBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "hiblaphp/event-loop": "^1.0",
        "hiblaphp/promise": "^1.0",
        "hiblaphp/cancellation": "^1.0",
        "hiblaphp/async": "^1.0",
        "hiblaphp/mysql": "^1.0",
        "hiblaphp/postgres": "^1.0",
        "rcalicdan/query-builder-primitives": "^1.0",
        "rcalicdan/config-loader": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.10",
        "pestphp/pest": "^4.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "scripts": {
        "test": "./vendor/bin/pest",
        "test:mysql": [
            "@putenv DATABASE=mysql",
            "./vendor/bin/pest --compact"
        ],
        "test:pgsql": [
            "@putenv DATABASE=pgsql",
            "./vendor/bin/pest --compact"
        ],
        "test:all": [
            "@test:mysql",
            "@test:pgsql"
        ],
        "format": "./vendor/bin/pint",
        "format-test": "./vendor/bin/pint --test",
        "analyze": "./vendor/bin/phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}